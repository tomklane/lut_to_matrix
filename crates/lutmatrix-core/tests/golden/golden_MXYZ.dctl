// ============================================================================
// LUT Matrix - 3x3 colour matrix in linear CIE XYZ, extracted from a LUT
// ----------------------------------------------------------------------------
// Source LUT:    Golden Test LUT.cube
// LUT input:     ARRI LogC4 / AWG4
// LUT output:    Rec.709 / Gamma 2.4
// White mode:    D65 (Bradford CAT from LUT white + exact D65 neutral constraint)
// Middle gray:   scene 0.1800, display 12.81 cd/m2
// Fit:           least squares, refined by minimising dE2000
// Fit error:     dE2000: mean 1.000, p95 2.000, max 3.000
// Generated by:  LUT Matrix {VERSION} on 2026-01-01 (UTC)
// ----------------------------------------------------------------------------
// Input and output: DaVinci Wide Gamut / DaVinci Intermediate.
// Pipeline: DI -> linear DWG -> XYZ (DWG_TO_XYZ) -> M_XYZ (blended by
// 'Matrix Amount') -> linear DWG (XYZ_TO_DWG) -> DI.
// Place it where the timeline is DWG/DI, before the output transform.
//
// DWG primaries R(0.8000, 0.3130) G(0.1682, 0.9877) B(0.0790, -0.1155), white
// D65 (0.3127, 0.3290), and the DaVinci Intermediate constants are from
// Blackmagic Design, "DaVinci Wide Gamut Intermediate" v1.1 (2021-07-31).
// DWG<->XYZ matrices are derived from those primaries in double precision.
// ============================================================================

DEFINE_UI_PARAMS(p_Amount, Matrix Amount, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.001)

typedef struct
{
    float3 r0, r1, r2; // rows
} Mat3x3;

__DEVICE__ float3 mat_mul(Mat3x3 m, float3 v)
{
    return make_float3(m.r0.x * v.x + m.r0.y * v.y + m.r0.z * v.z,
                       m.r1.x * v.x + m.r1.y * v.y + m.r1.z * v.z,
                       m.r2.x * v.x + m.r2.y * v.y + m.r2.z * v.z);
}

// Linear DaVinci Wide Gamut -> CIE XYZ (D65).
__DEVICE__ Mat3x3 DWG_TO_XYZ()
{
    Mat3x3 m;
    m.r0 = make_float3(   0.7006223921f,    0.1487748151f,    0.1010587198f);
    m.r1 = make_float3(   0.2741185109f,    0.8736318959f,   -0.1477504068f);
    m.r2 = make_float3(  -0.0989629129f,   -0.1378953251f,    1.3259159887f);
    return m;
}

// Fitted colour matrix in linear CIE XYZ (D65): XYZ in -> XYZ out.
__DEVICE__ Mat3x3 M_XYZ()
{
    Mat3x3 m;
    m.r0 = make_float3(   1.0793569788f,   -0.0599642766f,    0.0199880922f);
    m.r1 = make_float3(  -0.0299821383f,    1.0393807944f,   -0.0099940461f);
    m.r2 = make_float3(   0.0099940461f,   -0.0699583227f,    1.0993450710f);
    return m;
}

// CIE XYZ (D65) -> linear DaVinci Wide Gamut.
__DEVICE__ Mat3x3 XYZ_TO_DWG()
{
    Mat3x3 m;
    m.r0 = make_float3(   1.5166720420f,   -0.2814780479f,   -0.1469636332f);
    m.r1 = make_float3(  -0.4649171012f,    1.2514237757f,    0.1748846089f);
    m.r2 = make_float3(   0.0648490471f,    0.1091393437f,    0.7614146215f);
    return m;
}

// DaVinci Intermediate (Blackmagic, DWG Intermediate v1.1).
#define DI_A        0.0075000000f
#define DI_B        7.0000000000f
#define DI_C        0.0732924800f
#define DI_M        10.4442685500f
#define DI_LIN_CUT  0.0026240900f
#define DI_LOG_CUT  0.0274066800f

__DEVICE__ float di_to_linear(float v)
{
    if (v <= DI_LOG_CUT) return v / DI_M;
    return _powf(2.0f, v / DI_C - DI_B) - DI_A;
}

__DEVICE__ float linear_to_di(float l)
{
    if (l <= DI_LIN_CUT) return l * DI_M;
    return (_log2f(l + DI_A) + DI_B) * DI_C;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    // 1. DaVinci Intermediate -> linear DaVinci Wide Gamut
    float3 dwg = make_float3(di_to_linear(p_R), di_to_linear(p_G), di_to_linear(p_B));

    // 2. Linear DWG -> CIE XYZ
    float3 xyz = mat_mul(DWG_TO_XYZ(), dwg);

    // 3. Fitted matrix in XYZ, blended with identity (p_Amount = 0 is a no-op)
    float3 fit = mat_mul(M_XYZ(), xyz);
    xyz = make_float3(xyz.x + (fit.x - xyz.x) * p_Amount,
                      xyz.y + (fit.y - xyz.y) * p_Amount,
                      xyz.z + (fit.z - xyz.z) * p_Amount);

    // 4. CIE XYZ -> linear DWG
    dwg = mat_mul(XYZ_TO_DWG(), xyz);

    // 5. Linear DWG -> DaVinci Intermediate
    return make_float3(linear_to_di(dwg.x), linear_to_di(dwg.y), linear_to_di(dwg.z));
}
